# ==============================================================================
# QUICKSERVE FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Mandatory: The base URL of the QuickServe backend API
# Required for production builds. Locally, omit this value to keep generating
# links from the active localhost origin.
# FRONTEND_BASE_URL=https://app.quickservehq.com

NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Mandatory: The public publishable key from your Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
