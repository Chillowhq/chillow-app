# ==============================================================================
# CHILLOW FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Exact frontend origin. Required for production builds and injected into
# NEXT_PUBLIC_FRONTEND_BASE_URL by next.config.mjs for canonical frontend links.
# Local: http://localhost:3000
# Sandbox after cutover: https://sandbox.app.chillow.io
# Production after cutover: https://app.chillow.io
FRONTEND_BASE_URL=http://localhost:3000

# API base URL. Keep this environment-specific; Chillow API hosts are not
# assumed to be live until their respective backend environments are deployed.
# Sandbox after backend deployment: https://sandbox.api.chillow.io
# Production after backend deployment: https://api.chillow.io
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Mandatory: The public publishable key from your Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
